# VisualMath frontend runtime
# Leave empty for fully local-first mode.
VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=12000

# Set true in deployments that must not boot without a configured backend URL.
VITE_REQUIRE_BACKEND=false

# Deployment label used by runtime diagnostics.
VITE_APP_ENV=development

# Inject the deployed git SHA in CI/CD.
VITE_BUILD_SHA=dev

# Optional HTTPS endpoint accepting privacy-minimal runtime error beacons.
VITE_ERROR_REPORT_URL=
