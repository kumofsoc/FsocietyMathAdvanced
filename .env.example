# Optional backend. Without it VisualMath stays fully local-first.
# Origin only: do NOT append /api.
VITE_API_BASE_URL=http://localhost:8080

# HTTP timeout for frontend -> backend requests.
VITE_API_TIMEOUT_MS=12000

# Optional generic JSON ingestion endpoint for runtime errors.
# Leave empty to keep errors console-only.
VITE_ERROR_REPORTING_URL=

# Build/release identifier. Production should set this to the deployed git SHA.
VITE_APP_RELEASE=dev
