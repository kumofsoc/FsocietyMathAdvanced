{
  "name": "mathmamath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "tsc -p tsconfig.app.json --noEmit --pretty false --noUnusedLocals --noUnusedParameters",
    "build": "tsc -b && vite build && node scripts/generate-seo.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "test:analytics": "node --test scripts/analytics.test.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "test:e2e:production": "playwright test e2e/production-image.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:e2e:backend": "playwright test -c playwright.backend.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "katex": "^0.16.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-katex": "^3.1.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15",
    "@antv/g6": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.3",
    "@playwright/test": "^1.55.0"
  },
  "packageManager": "pnpm@11.28.4"
}
